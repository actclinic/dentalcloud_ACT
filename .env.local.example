# Copy to .env.local and replace every REPLACE_* value before local testing.
# This metadata is validated now; wiring ACT_SUPABASE_URL into the browser client
# is a separate change and is intentionally not part of this configuration task.
ACT_ENVIRONMENT=local
ACT_APP_ORIGIN=http://localhost:3000
ACT_SUPABASE_URL=REPLACE_WITH_ISOLATED_SUPABASE_URL
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AI_API_KEY=REPLACE_WITH_BROWSER_RESTRICTED_KEY
VITE_DATABASE_FILTERED_DIRECTORIES=true
